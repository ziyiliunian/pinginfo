#!/usr/bin/env python3
# PingInfo 启动器
# 安装后源码位于 /usr/share/pinginfo，包结构为 src/pinginfo（含 src/__init__.py）
import sys
import os

# 程序安装根目录（打包后位于 /usr/share/pinginfo）
BASE_DIR = "/usr/share/pinginfo"
if os.path.isdir(BASE_DIR) and BASE_DIR not in sys.path:
    sys.path.insert(0, BASE_DIR)

if __name__ == "__main__":
    from src.main import main
    main()
